# ==========================================
# Proho Monorepo Environment Configuration Example
# ==========================================

# -----------------
# Backend (Django)
# -----------------
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Database Configuration
# Leave DB_ENGINE empty or unset to default to SQLite (backend/db.sqlite3) for local development.
# Set DB_ENGINE=django.db.backends.postgresql for AWS RDS/production PostgreSQL.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# AWS S3 Storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=proho-storage
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=

# Security & OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Default Currency
DEFAULT_CURRENCY=INR

# -----------------
# Admin Web (React)
# -----------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# -----------------
# Mobile (Expo)
# -----------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
