SECRET_KEY=django-insecure-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Database Configuration
# Leave DB_ENGINE empty or unset to default to SQLite (backend/db.sqlite3) for local development.
# Set DB_ENGINE=django.db.backends.postgresql for AWS RDS/production PostgreSQL.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Storage (AWS S3)
USE_S3=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=proho-storage
AWS_S3_REGION_NAME=ap-southeast-2



# Business Configuration
DEFAULT_CURRENCY=INR
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
MINIMUM_PAYOUT_AMOUNT=5000.00
REFERRAL_ATTRIBUTION_DAYS=60
